#!/usr/bin/env python3
"""
matrix — Matrix rain over a ghost of your face.

A static ghost of your face glows behind classic Matrix rain: the newest
photo (or the detected face) is used as a brightness map and rendered as a
persistent low-brightness layer while katakana rain falls over it. Default
ghost brightness is 0.28 — tune it with --ghost.

The photo is looked up in this order:
    1. explicit path argument
    2. bundled ref/ folder next to this script (works straight after clone)
    3. ~/Desktop/ref (local override)

Usage:
    matrix [IMAGE] [options]

Examples:
    matrix                      # use bundled photo in ./ref (or ~/Desktop/ref)
    matrix ~/me.jpg             # use a specific photo
    matrix --ghost 0.5          # brighter static face behind the rain
    matrix --speed 2 --fps 60   # faster rain

Press Ctrl+C to exit (restores the terminal).
"""

import argparse
import atexit
import os
import random
import signal
import sys
import time

import numpy as np
from PIL import Image

# Bundled photos travel with the script (repo layout: <dir>/ref/*.jpg).
BUNDLE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ref")
REF_DIR = os.path.expanduser("~/Desktop/ref")
EXTS = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")

# Half-width katakana (single column width) + digits + a few ASCII glyphs.
GLYPHS = (
    "ｦｱｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ"
    "0123456789"
    "@#$%&*+=:."
)

DEFAULT_SIZE = (80, 24)

_should_exit = False


def _sig_handler(_sig, _frame):
    global _should_exit
    _should_exit = True


def _restore_terminal():
    try:
        sys.stdout.write("\x1b[?25h\x1b[0m\x1b[2J\x1b[H")
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        pass


def _newest_in(directory):
    """Return the most recently modified image in directory, or None."""
    try:
        imgs = [f for f in os.listdir(directory) if f.lower().endswith(EXTS)]
    except OSError:
        return None
    if not imgs:
        return None
    imgs.sort(key=lambda f: os.path.getmtime(os.path.join(directory, f)),
              reverse=True)
    return os.path.join(directory, imgs[0])


def pick_image(path=None):
    """Resolve the image: explicit path > bundled ref/ > ~/Desktop/ref."""
    if path:
        if os.path.isdir(path):
            img = _newest_in(path)
            if img:
                return img
            sys.exit(f"no images found in {path}")
        if not os.path.isfile(path):
            sys.exit(f"image not found: {path}")
        return path
    for directory in (BUNDLE_DIR, REF_DIR):
        img = _newest_in(directory)
        if img:
            return img
    sys.exit(
        f"no photos found in {BUNDLE_DIR} or {REF_DIR} "
        "(pass an image path to matrix)")



def detect_face(gray):
    """Largest frontal face via OpenCV Haar cascade; None if unavailable."""
    try:
        import cv2
        cascade = cv2.CascadeClassifier(
            cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
        )
        faces = cascade.detectMultiScale(
            gray.astype(np.uint8), scaleFactor=1.1, minNeighbors=5,
            minSize=(40, 40))
        if len(faces):
            x, y, w, h = max(faces, key=lambda f: f[2] * f[3])
            return int(x), int(y), int(w), int(h)
    except Exception:
        pass
    return None


def load_mask(img_path, cols, rows, invert=False, no_crop=False):
    """Build a 0..1 brightness map sized (rows, cols) covering the full grid.

    The photo (or the detected face, by default) is scale-to-cover resized so
    the falling letters fill the entire terminal screen.
    """
    gray = np.asarray(Image.open(img_path).convert("L"), dtype=np.float32)
    bbox = detect_face(gray) if not no_crop else None
    src = gray
    if bbox:
        x, y, w, h = bbox
        px, py = int(w * 0.15), int(h * 0.12)
        x0, y0 = max(0, x - px), max(0, y - py)
        x1 = min(gray.shape[1], x + w + px)
        y1 = min(gray.shape[0], y + h + py)
        src = gray[y0:y1, x0:x1]
    # Scale-to-cover: fill the (cols, rows*2) pixel grid, center-crop overflow.
    th, tw = rows * 2, cols
    ih, iw = src.shape[:2]
    scale = max(tw / iw, th / ih)
    nw, nh = max(int(iw * scale), tw), max(int(ih * scale), th)
    try:
        import cv2
        resized = cv2.resize(src, (nw, nh), interpolation=cv2.INTER_AREA)
    except Exception:
        resized = np.asarray(
            Image.fromarray(src.astype(np.uint8)).resize(
                (nw, nh), Image.LANCZOS), dtype=np.float32)
    cx0, cy0 = (nw - tw) // 2, (nh - th) // 2
    small = resized[cy0:cy0 + th, cx0:cx0 + tw]
    # Terminal cells are ~2x taller than wide: average each pixel pair.
    mask = (small[0::2] + small[1::2]) / 2.0
    lo, hi = np.percentile(mask, [2, 98])
    lo, hi = float(lo), float(hi)
    if hi - lo < 1e-3:
        hi = lo + 1e-3
    mask = np.clip((mask - lo) / (hi - lo), 0.0, 1.0)
    if invert:
        mask = 1.0 - mask
    return np.power(mask, 1.3)


def color_for(intensity):
    """Classic matrix green scaled by intensity; returns (r, g, b)."""
    i = max(0.0, min(1.0, intensity))
    g = int(10 + 245 * i)
    return int(g * 0.25), g, int(g * 0.45)


HEAD_COLOR = (215, 255, 215)  # bright white-green stream heads


def init_streams(cols, rows, rng):
    """Create one falling stream per column."""
    streams = []
    for c in range(cols):
        streams.append({
            "col": c,
            "head": -rng.uniform(0.0, float(rows)),
            "speed": rng.uniform(0.35, 1.5) * (1.0 + rows / 30.0),
            "trail": rng.randint(5, max(6, min(rows, 22))),
        })
    return streams


def run(img_path, fps, speed, ghost, invert, no_crop, cols=None, rows=None):
    rng = random.Random()
    time_step = 1.0 / fps

    def get_size():
        if cols and rows:
            return cols, rows
        try:
            c, r = os.get_terminal_size(sys.stdout.fileno())
        except (OSError, ValueError):
            c, r = DEFAULT_SIZE
        return (cols or c), (rows or r)

    last_size = None
    mask = None
    streams = None
    cur_ch = None   # 2D list: last emitted char per cell
    cur_fg = None   # 2D list: last emitted color per cell

    sys.stdout.write("\x1b[?25l\x1b[2J\x1b[H")
    sys.stdout.flush()

    while not _should_exit:
        t0 = time.perf_counter()
        size = get_size()
        if size != last_size:
            cols, rows = size
            cols = max(20, min(cols, 400))
            rows = max(8, min(rows, 200))
            mask = load_mask(img_path, cols, rows, invert, no_crop)
            streams = init_streams(cols, rows, rng)
            cur_ch = [[""] * cols for _ in range(rows)]
            cur_fg = [[None] * cols for _ in range(rows)]
            sys.stdout.write("\x1b[2J\x1b[H")
            last_size = (cols, rows)

        out = ["\x1b[H"]
        for r in range(rows):
            mrow = mask[r]
            chrow = cur_ch[r]
            fgrow = cur_fg[r]
            for c in range(cols):
                m = mrow[c]
                if m < 0.06:                  # outside the silhouette
                    ch = ""
                    fg = None
                else:
                    s = streams[c]
                    d = s["head"] - r
                    if 0 <= d < s["trail"]:    # inside a falling stream
                        trail_f = 1.0 - d / s["trail"]
                        if d < 1 or rng.random() < 0.55:
                            ch = rng.choice(GLYPHS)
                        else:
                            ch = chrow[c] or rng.choice(GLYPHS)
                        fg = HEAD_COLOR if d < 1 else \
                            color_for(m * (ghost + (1.0 - ghost) * trail_f))
                    else:                      # between streams: static ghost
                        ch = chrow[c]
                        if not ch or rng.random() < 0.02:
                            ch = rng.choice(GLYPHS)
                        fg = color_for(m * ghost)
                if ch != chrow[c] or fg != fgrow[c]:
                    if ch:
                        out.append(
                            f"\x1b[{r + 1};{c + 1}H"
                            f"\x1b[38;2;{fg[0]};{fg[1]};{fg[2]}m{ch}")
                    else:
                        out.append(f"\x1b[{r + 1};{c + 1}H ")
                    chrow[c], fgrow[c] = ch, fg

        for s in streams:                     # advance the rain
            s["head"] += s["speed"] * speed * time_step
            if s["head"] - s["trail"] > rows:
                s["head"] = -rng.uniform(0.0, rows * 0.8)
                s["speed"] = rng.uniform(0.35, 1.5) * (1.0 + rows / 30.0)
                s["trail"] = rng.randint(5, max(6, min(rows, 22)))

        sys.stdout.write("".join(out))
        sys.stdout.flush()
        dt = time.perf_counter() - t0
        time.sleep(max(0.0, time_step - dt))


def main():
    parser = argparse.ArgumentParser(
        prog="matrix",
        description="Matrix rain over a ghost of your face.")
    parser.add_argument("image", nargs="?", default=None,
                        help="photo path or directory "
                             "(default: bundled ref/ next to the script, "
                             "then ~/Desktop/ref)")
    parser.add_argument("--fps", type=int, default=30, help="frames/sec (default 30)")
    parser.add_argument("--speed", type=float, default=1.0,
                        help="rain speed multiplier (default 1.0)")
    parser.add_argument("--ghost", type=float, default=0.28,
                        help="static face glow behind the rain 0..1 (default 0.28)")
    parser.add_argument("--invert", action="store_true",
                        help="invert the face mask")
    parser.add_argument("--no-crop", action="store_true",
                        help="use the whole image instead of the detected face")
    parser.add_argument("--cols", type=int, default=None, help="force grid width")
    parser.add_argument("--rows", type=int, default=None, help="force grid height")
    args = parser.parse_args()

    img = pick_image(args.image)
    signal.signal(signal.SIGINT, _sig_handler)
    signal.signal(signal.SIGTERM, _sig_handler)
    atexit.register(_restore_terminal)
    run(img, args.fps, args.speed, args.ghost, args.invert,
        args.no_crop, args.cols, args.rows)


if __name__ == "__main__":
    main()
